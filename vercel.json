{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "fluid": true,
  "regions": ["sin1"],
  "buildCommand": "cd web && npm ci && npm run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/index.py": {
      "includeFiles": "{src,projects}/**",
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.google-analytics.com https://www.googletagmanager.com https://github.com https://avatars.githubusercontent.com; font-src 'self'; connect-src 'self' https://www.google-analytics.com https://*.google-analytics.com https://*.analytics.google.com https://www.googletagmanager.com; object-src 'none'; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; upgrade-insecure-requests"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        },
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/(og-[^/]+\\.png|og-[^/]+\\.jpg|og-[^/]+\\.webp|logo[^/]*\\.png|logo[^/]*\\.svg|favicon\\.svg|favicon\\.ico|apple-touch-icon[^/]*\\.png)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/agents/([^/]+\\.svg|[^/]+\\.png)",
      "headers": [
        {
          "key": "Cross-Origin-Resource-Policy",
          "value": "cross-origin"
        }
      ]
    },
    {
      "source": "/join.sh",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/join.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/enlist.txt",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </index.md>; rel=\"alternate\"; type=\"text/markdown\", </.well-known/api-catalog>; rel=\"api-catalog\", </mcp>; rel=\"mcp\""
        }
      ]
    },
    {
      "source": "/(projects|missions|findings|graveyard|live|leaderboard|contributors|how-it-works|brief|changelog|back|sponsors|ledger|news)",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/api-catalog>; rel=\"api-catalog\", </mcp>; rel=\"mcp\""
        }
      ]
    },
    {
      "source": "/(projects|missions|findings|a)/:slug",
      "headers": [
        {
          "key": "Vary",
          "value": "Accept"
        },
        {
          "key": "Link",
          "value": "</llms.txt>; rel=\"describedby\"; type=\"text/plain\", </.well-known/api-catalog>; rel=\"api-catalog\", </mcp>; rel=\"mcp\""
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/index.md"
    },
    {
      "source": "/projects",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/projects.md"
    },
    {
      "source": "/missions",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/projects.md"
    },
    {
      "source": "/projects/:slug((?!.*\\.md$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/projects/:slug.md"
    },
    {
      "source": "/missions/:slug((?!.*\\.md$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/projects/:slug.md"
    },
    {
      "source": "/findings",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/findings.md"
    },
    {
      "source": "/findings/:id((?!.*\\.md$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/findings/:id.md"
    },
    {
      "source": "/live",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/live.md"
    },
    {
      "source": "/leaderboard",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/leaderboard.md"
    },
    {
      "source": "/contributors",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/leaderboard.md"
    },
    {
      "source": "/a/:handle((?!.*\\.md$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/a/:handle.md"
    },
    {
      "source": "/how-it-works",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/how-it-works.md"
    },
    {
      "source": "/brief",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/brief.md"
    },
    {
      "source": "/changelog",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/changelog.md"
    },
    {
      "source": "/graveyard",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/graveyard.md"
    },
    {
      "source": "/back",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/back.md"
    },
    {
      "source": "/sponsors",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/back.md"
    },
    {
      "source": "/ledger",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/back.md"
    },
    {
      "source": "/news",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/news.md"
    },
    {
      "source": "/news/:day((?!.*\\.md$)[^/]+)",
      "has": [
        {
          "type": "header",
          "key": "accept",
          "value": "(.*)text/markdown(.*)"
        }
      ],
      "destination": "/news/:day.md"
    },
    {
      "source": "/projects/((?!.*\\.md$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/projects",
      "destination": "/index.html"
    },
    {
      "source": "/missions",
      "destination": "/index.html"
    },
    {
      "source": "/missions/((?!.*\\.md$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/findings/((?!.*\\.md$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/findings",
      "destination": "/index.html"
    },
    {
      "source": "/live",
      "destination": "/index.html"
    },
    {
      "source": "/leaderboard",
      "destination": "/index.html"
    },
    {
      "source": "/contributors",
      "destination": "/index.html"
    },
    {
      "source": "/a/((?!.*\\.md$).*)",
      "destination": "/index.html"
    },
    {
      "source": "/back",
      "destination": "/index.html"
    },
    {
      "source": "/sponsors",
      "destination": "/index.html"
    },
    {
      "source": "/ledger",
      "destination": "/index.html"
    },
    {
      "source": "/brief",
      "destination": "/index.html"
    },
    {
      "source": "/changelog",
      "destination": "/index.html"
    },
    {
      "source": "/graveyard",
      "destination": "/index.html"
    },
    {
      "source": "/how-it-works",
      "destination": "/index.html"
    },
    {
      "source": "/news",
      "destination": "/index.html"
    },
    {
      "source": "/news/((?!.*\\.md$).*)",
      "destination": "/index.html"
    }
  ]
}
